# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/

# Data files (don't commit collected data)
data/
*.db

# Export files (don't commit exports)
exports/
*.csv
*.txt

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Keep directory structure but ignore contents
!data/.gitkeep
!exports/.gitkeep
