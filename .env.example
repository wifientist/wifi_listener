# WiFi Listener Configuration
# Copy this file to .env and customize your settings

# Default test duration in minutes (0 = manual stop)
DEFAULT_DURATION_MINUTES=5

# WiFi sampling interval in seconds
SAMPLE_INTERVAL_SECONDS=4.0

# iperf3 default server (leave empty to disable by default)
IPERF3_SERVER=

# iperf3 default port
IPERF3_PORT=5201

# iperf3 default parallel streams (recommended: 4 for WiFi testing)
IPERF3_PARALLEL=1

# Database path (relative to project directory)
DATABASE_PATH=data/wifi_metrics.db

# Exports directory (relative to project directory)
EXPORTS_PATH=exports
